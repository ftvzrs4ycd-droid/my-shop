<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>单机商城</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f5f5; color: #333; }
header { position: sticky; top: 0; background: #fff; z-index: 10; box-shadow: 0 1px 4px rgba(0,0,0,0.06); }
.search-bar { display: flex; padding: 10px 12px 8px; gap: 8px; align-items: center; }
.search-bar input { flex: 1; padding: 10px 14px; border: 1px solid #e8e8e8; border-radius: 20px; font-size: 14px; outline: none; background: #f7f7f7; }
.search-bar input:focus { background: #fff; border-color: #ff6b35; }
#cartBtn { position: relative; background: #ff6b35; color: #fff; border: none; border-radius: 20px; padding: 10px 16px; font-size: 15px; cursor: pointer; }
#cartCount { position: absolute; top: -6px; right: -6px; background: #e53935; color: #fff; font-size: 10px; border-radius: 10px; padding: 1px 5px; min-width: 16px; text-align: center; }
.categories { display: flex; overflow-x: auto; padding: 0 12px 10px; gap: 8px; scrollbar-width: none; }
.categories::-webkit-scrollbar { display: none; }
.cat-btn { flex-shrink: 0; padding: 6px 14px; border: 1px solid #e8e8e8; background: #fff; border-radius: 16px; font-size: 13px; color: #666; cursor: pointer; }
.cat-btn.active { background: #ff6b35; color: #fff; border-color: #ff6b35; }
#productList { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px; }
.product-card { background: #fff; border-radius: 10px; padding: 12px 8px; text-align: center; cursor: pointer; transition: transform 0.1s; }
.product-card:active { transform: scale(0.97); }
.product-img { font-size: 42px; line-height: 1; margin-bottom: 8px; }
.product-name { font-size: 13px; color: #333; margin-bottom: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.product-price { font-size: 15px; color: #ff6b35; font-weight: 600; }
.drawer-mask { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 20; }
.drawer-mask.show { display: block; }
.drawer { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 16px 16px 0 0; z-index: 21; transform: translateY(100%); transition: transform 0.25s ease; max-height: 70vh; display: flex; flex-direction: column; }
.drawer.show { transform: translateY(0); }
.drawer-header { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-bottom: 1px solid #f0f0f0; }
.drawer-header h3 { font-size: 16px; }
.drawer-header button { background: none; border: none; font-size: 18px; color: #999; cursor: pointer; }
.drawer-body { flex: 1; overflow-y: auto; padding: 8px 16px; }
.drawer-footer { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-top: 1px solid #f0f0f0; }
.drawer-footer button { background: #ff6b35; color: #fff; border: none; border-radius: 20px; padding: 10px 24px; font-size: 15px; cursor: pointer; }
.cart-item { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #f7f7f7; }
.cart-item-info { flex: 1; min-width: 0; }
.cart-item-name { font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cart-item-price { font-size: 12px; color: #999; margin-top: 2px; }
.qty-control { display: flex; align-items: center; gap: 8px; }
.qty-control button { width: 26px; height: 26px; border-radius: 50%; border: 1px solid #e0e0e0; background: #fff; font-size: 16px; line-height: 1; cursor: pointer; color: #666; }
.qty-control span { min-width: 20px; text-align: center; font-size: 14px; }
.cart-item-subtotal { font-size: 13px; color: #ff6b35; font-weight: 600; min-width: 56px; text-align: right; }
.modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 30; align-items: center; justify-content: center; padding: 20px; }
.modal.show { display: flex; }
.modal-content { background: #fff; border-radius: 12px; padding: 20px; width: 100%; max-width: 400px; max-height: 80vh; overflow-y: auto; }
.modal-content h3 { font-size: 17px; margin-bottom: 14px; }
.modal-content input, .modal-content textarea { width: 100%; padding: 10px 12px; border: 1px solid #e8e8e8; border-radius: 8px; font-size: 14px; margin-bottom: 10px; outline: none; }
.modal-content input:focus, .modal-content textarea:focus { border-color: #ff6b35; }
.modal-content textarea { height: 60px; resize: none; }
.modal-actions { display: flex; gap: 10px; margin-top: 6px; }
.modal-actions button { flex: 1; padding: 11px; border-radius: 22px; font-size: 15px; cursor: pointer; border: none; }
#cancelCheckout { background: #f0f0f0; color: #666; }
#submitOrder { background: #ff6b35; color: #fff; }
#orderText { background: #f7f7f7; padding: 12px; border-radius: 8px; font-size: 12px; line-height: 1.6; white-space: pre-wrap; word-break: break-all; margin-bottom: 12px; font-family: inherit; }
#copyOrder { width: 100%; padding: 12px; background: #ff6b35; color: #fff; border: none; border-radius: 22px; font-size: 15px; cursor: pointer; margin-bottom: 8px; }
#closeOrder { width: 100%; padding: 12px; background: #f0f0f0; color: #666; border: none; border-radius: 22px; font-size: 15px; cursor: pointer; }
</style>
</head>
<body>
<header>
  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="搜索商品...">
    <button id="cartBtn">🛒 <span id="cartCount">0</span></button>
  </div>
  <div class="categories" id="categories"></div>
</header>
<main id="productList"></main>

<div class="drawer-mask" id="drawerMask"></div>
<div class="drawer" id="cartDrawer">
  <div class="drawer-header">
    <h3>购物车</h3>
    <button id="closeCart">✕</button>
  </div>
  <div class="drawer-body" id="cartItems"></div>
  <div class="drawer-footer">
    <div>合计：<span id="cartTotal" style="color:#ff6b35;font-weight:600;">¥0.00</span></div>
    <button id="checkoutBtn">去结算</button>
  </div>
</div>

<div class="modal" id="checkoutModal">
  <div class="modal-content">
    <h3>填写收货信息</h3>
    <input id="buyerName" placeholder="姓名">
    <input id="buyerPhone" placeholder="电话">
    <input id="buyerAddress" placeholder="地址">
    <textarea id="buyerNote" placeholder="备注（可选）"></textarea>
    <div class="modal-actions">
      <button id="cancelCheckout">取消</button>
      <button id="submitOrder">提交订单</button>
    </div>
  </div>
</div>

<div class="modal" id="orderModal">
  <div class="modal-content">
    <h3>订单已生成</h3>
    <pre id="orderText"></pre>
    <button id="copyOrder">复制订单信息</button>
    <button id="closeOrder">关闭</button>
  </div>
</div>

<script>
// ========== 商品数据（替换成你自己的即可） ==========
const CATEGORIES = ['蔬菜','水果','肉禽蛋','海鲜','粮油','调味','零食','饮料','日用品','冷冻'];
const CAT_EMOJI = {蔬菜:'🥬',水果:'🍎',肉禽蛋:'🥩',海鲜:'🦐',粮油:'🍚',调味:'🧂',零食:'🍪',饮料:'🥤',日用品:'🧴',冷冻:'🧊'};

const PRODUCTS = [];
let pid = 1;
CATEGORIES.forEach(cat => {
  for (let i = 1; i <= 100; i++) {
    PRODUCTS.push({
      id: pid++,
      name: `${cat}${String(i).padStart(3,'0')}号`,
      price: +(Math.random() * 50 + 3).toFixed(2),
      category: cat,
      emoji: CAT_EMOJI[cat],
      stock: Math.floor(Math.random() * 200) + 10
    });
  }
});
// ================================================

let currentCategory = CATEGORIES[0];
let searchKeyword = '';
let cart = JSON.parse(localStorage.getItem('single_mall_cart') || '{}');
let lastOrderText = '';

const categoriesEl = document.getElementById('categories');
CATEGORIES.forEach((cat, idx) => {
  const btn = document.createElement('button');
  btn.className = 'cat-btn' + (idx === 0 ? ' active' : '');
  btn.textContent = cat;
  btn.dataset.cat = cat;
  categoriesEl.appendChild(btn);
});
categoriesEl.addEventListener('click', e => {
  const btn = e.target.closest('.cat-btn');
  if (!btn) return;
  currentCategory = btn.dataset.cat;
  searchKeyword = '';
  document.getElementById('searchInput').value = '';
  document.querySelectorAll('.cat-btn').forEach(b => b.classList.toggle('active', b === btn));
  renderProducts();
});

function renderProducts() {
  const list = document.getElementById('productList');
  let items;
  if (searchKeyword) {
    items = PRODUCTS.filter(p => p.name.includes(searchKeyword)).slice(0, 50);
  } else {
    items = PRODUCTS.filter(p => p.category === currentCategory);
  }
  if (!items.length) {
    list.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:#999;padding:40px 0;">没有找到商品</div>';
    return;
  }
  list.innerHTML = items.map(p => `
    <div class="product-card" data-id="${p.id}">
      <div class="product-img">${p.emoji}</div>
      <div class="product-name">${p.name}</div>
      <div class="product-price">¥${p.price.toFixed(2)}</div>
    </div>
  `).join('');
}

document.getElementById('searchInput').addEventListener('input', e => {
  searchKeyword = e.target.value.trim();
  renderProducts();
});

function saveCart() {
  localStorage.setItem('single_mall_cart', JSON.stringify(cart));
  updateCartUI();
}
function addToCart(id) {
  cart[id] = (cart[id] || 0) + 1;
  saveCart();
}
function changeQty(id, delta) {
  if (!cart[id]) return;
  cart[id] += delta;
  if (cart[id] <= 0) delete cart[id];
  saveCart();
}
function cartItems() {
  return Object.entries(cart).map(([id, qty]) => {
    const p = PRODUCTS.find(x => x.id === +id);
    return { ...p, qty, subtotal: p.price * qty };
  });
}
function cartTotal() {
  return cartItems().reduce((s, i) => s + i.subtotal, 0);
}
function updateCartUI() {
  const count = Object.values(cart).reduce((s, q) => s + q, 0);
  document.getElementById('cartCount').textContent = count;
  const items = cartItems();
  const body = document.getElementById('cartItems');
  if (!items.length) {
    body.innerHTML = '<div style="text-align:center;color:#999;padding:40px 0;">购物车是空的</div>';
  } else {
    body.innerHTML = items.map(i => `
      <div class="cart-item">
        <div class="cart-item-info">
          <div class="cart-item-name">${i.emoji} ${i.name}</div>
          <div class="cart-item-price">¥${i.price.toFixed(2)}</div>
        </div>
        <div class="qty-control">
          <button data-id="${i.id}" data-delta="-1">−</button>
          <span>${i.qty}</span>
          <button data-id="${i.id}" data-delta="1">+</button>
        </div>
        <div class="cart-item-subtotal">¥${i.subtotal.toFixed(2)}</div>
      </div>
    `).join('');
  }
  document.getElementById('cartTotal').textContent = '¥' + cartTotal().toFixed(2);
}

const cartDrawer = document.getElementById('cartDrawer');
const drawerMask = document.getElementById('drawerMask');
document.getElementById('cartBtn').onclick = () => {
  cartDrawer.classList.add('show');
  drawerMask.classList.add('show');
};
function closeCart() {
  cartDrawer.classList.remove('show');
  drawerMask.classList.remove('show');
}
document.getElementById('closeCart').onclick = closeCart;
drawerMask.onclick = closeCart;

document.getElementById('cartItems').addEventListener('click', e => {
  const btn = e.target.closest('button[data-id]');
  if (!btn) return;
  changeQty(+btn.dataset.id, +btn.dataset.delta);
});

document.getElementById('productList').addEventListener('click', e => {
  const card = e.target.closest('.product-card');
  if (!card) return;
  addToCart(+card.dataset.id);
  card.style.transform = 'scale(0.95)';
  setTimeout(() => card.style.transform = '', 100);
});

const checkoutModal = document.getElementById('checkoutModal');
document.getElementById('checkoutBtn').onclick = () => {
  if (!Object.keys(cart).length) { alert('购物车是空的'); return; }
  closeCart();
  checkoutModal.classList.add('show');
};
document.getElementById('cancelCheckout').onclick = () => checkoutModal.classList.remove('show');

document.getElementById('submitOrder').onclick = () => {
  const name = document.getElementById('buyerName').value.trim();
  const phone = document.getElementById('buyerPhone').value.trim();
  const address = document.getElementById('buyerAddress').value.trim();
  const note = document.getElementById('buyerNote').value.trim();
  if (!name || !phone || !address) { alert('请填写姓名、电话和地址'); return; }
  const orderNo = genOrderNo();
  const items = cartItems();
  const total = cartTotal();
  const lines = [];
  lines.push('订单号：' + orderNo);
  lines.push('姓名：' + name);
  lines.push('电话：' + phone);
  lines.push('地址：' + address);
  if (note) lines.push('备注：' + note);
  lines.push('--------------------');
  items.forEach((i, idx) => {
    lines.push(`${idx + 1}. ${i.name} x${i.qty} = ¥${i.subtotal.toFixed(2)}`);
  });
  lines.push('--------------------');
  lines.push('合计：¥' + total.toFixed(2));
  lines.push('下单时间：' + new Date().toLocaleString('zh-CN'));
  lastOrderText = lines.join('\n');
  document.getElementById('orderText').textContent = lastOrderText;
  checkoutModal.classList.remove('show');
  document.getElementById('orderModal').classList.add('show');
  cart = {};
  saveCart();
  document.getElementById('buyerName').value = '';
  document.getElementById('buyerPhone').value = '';
  document.getElementById('buyerAddress').value = '';
  document.getElementById('buyerNote').value = '';
};

function genOrderNo() {
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  return 'ORD' + d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate()) + pad(d.getHours()) + pad(d.getMinutes()) + pad(d.getSeconds()) + Math.floor(Math.random() * 1000);
}

document.getElementById('closeOrder').onclick = () => document.getElementById('orderModal').classList.remove('show');
document.getElementById('copyOrder').onclick = () => copyText(lastOrderText);

function copyText(text) {
  const done = () => alert('订单信息已复制，请粘贴发送给商家');
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done));
  } else {
    fallbackCopy(text, done);
  }
}
function fallbackCopy(text, done) {
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.select();
  try { document.execCommand('copy'); done(); } catch (e) { alert('复制失败，请手动选择文本复制'); }
  document.body.removeChild(ta);
}

renderProducts();
updateCartUI();
</script>
</body>
</html>
